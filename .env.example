# Copy to .env locally. Never commit real values.
DATABASE_URL=postgresql://user:password@host:5432/database
OAUTH_ISSUER=http://localhost:3003
MCP_RESOURCE=http://localhost:3002/mcp
OAUTH_REDIRECT_URIS=http://127.0.0.1:3004/callback
MCP_INTROSPECTION_SECRET=generate-a-long-random-secret
OAUTH_INTROSPECTION_URL=http://localhost:3003/token/introspection
OAUTH_CLIENT_ID=northstar-mcp-backend
OAUTH_CLIENT_SECRET=use-the-same-secret-as-MCP_INTROSPECTION_SECRET
JWT_SECRET=generate-a-different-long-random-secret
# Optional locally; required in production. Register a separate public PKCE client.
# CHATGPT_CLIENT_ID=your-selected-chatgpt-client-id
# CHATGPT_REDIRECT_URIS=copy-the-exact-HTTPS-callback-from-ChatGPT
